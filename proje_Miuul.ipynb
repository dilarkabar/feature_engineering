  },
  {
   "cell_type": "code",
   "execution_count": 14,
   "id": "e6bf8516-c68b-4a92-855b-f1564b6e5c0c",
   "metadata": {},
   "outputs": [
    {
     "name": "stdout",
     "output_type": "stream",
     "text": [
      "   Customer_ID  Recency  Frequency  Monetary  Interest  Basket_Size RFMI_Score\n",
      "0            1       73          1      3491         1            5       5141\n",
      "1            2      939          1      4210         1            1       2141\n",
      "2            3      861          1      4735         1            5       2151\n",
      "3            4      613          1       924         1            1       3111\n",
