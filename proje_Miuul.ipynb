   ],
   "source": [
    "\n",
    "customer_id_map = data[['Customer_ID']].drop_duplicates().reset_index(drop=True)\n",
    "\n",
    "data['Purchase_Date'] = pd.to_datetime(data['Purchase_Date'])\n",
    "\n",
    "# En güncel tarihi al, 16 gün ekle\n",
    "current_date = data['Purchase_Date'].max() + pd.Timedelta(days=16)\n",
    "\n",
    "\n",
    "rfmi = data.groupby('Customer_ID').agg(\n",
    "    Recency=('Purchase_Date', lambda x: (current_date - x.max()).days),\n",
    "    Frequency=('Purchase_Date', 'count'),\n",
    "    Monetary=('Total_Purchase_Amount', 'sum'),\n",
    "    Interest=('Product_Category', pd.Series.nunique)\n",
    ").reset_index()\n",
    "\n",
    "# Basket_Size =müşterinin toplam aldığı ürün adedi\n",
    "data['Basket_Size'] = data.groupby('Customer_ID')['Quantity'].transform('sum')\n",
    "\n",
    "\n",
    "rfmi = rfmi.merge(data[['Customer_ID', 'Basket_Size']].drop_duplicates(), on='Customer_ID', how='left')\n",
    "\n",
    "# RFMI skorlarını 1-5 arası puanla (5 en iyi)\n",
    "rfmi['R_Score'] = pd.qcut(rfmi['Recency'], 5, labels=[5, 4, 3, 2, 1])\n",
    "rfmi['F_Score'] = pd.qcut(rfmi['Frequency'].rank(method='first'), 5, labels=[1, 2, 3, 4, 5])\n",
    "rfmi['M_Score'] = pd.qcut(rfmi['Monetary'].rank(method='first'), 5, labels=[1, 2, 3, 4, 5])\n",
    "rfmi['I_Score'] = pd.qcut(rfmi['Interest'].rank(method='first'), 5, labels=[1, 2, 3, 4, 5])\n",
    "\n",
    "\n",
    "rfmi['RFMI_Score'] = (\n",
    "    rfmi['R_Score'].astype(str) +\n",
    "    rfmi['F_Score'].astype(str) +\n",
    "    rfmi['M_Score'].astype(str) +\n",
    "    rfmi['I_Score'].astype(str)\n",
    ")\n",
    "\n",
    "\n",
    "print(rfmi[['Customer_ID', 'Recency', 'Frequency', 'Monetary', 'Interest', 'Basket_Size', 'RFMI_Score']].head())\n"
   ]
  },
