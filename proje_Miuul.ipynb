    "def segment_customer(row):\n",
    "    r = int(row['R_Score'])\n",
    "    f = int(row['F_Score'])\n",
    "    m = int(row['M_Score'])\n",
    "    i = int(row['I_Score'])\n",
    " \n",
    "    if r >= 4 and f >= 4 and m >= 4 and i >= 4:\n",
    "        return 'En Değerli Müşteri'\n",
    "    elif r >= 4 and f >= 4:\n",
    "        return 'Sadık Müşteri'\n",
    "    elif r <= 2:\n",
    "        return 'Riskli Müşteri'\n",
    "    elif f <= 2 and m <= 2 and i >= 4:\n",
    "        return 'İlgili Ama Az Harcayan'\n",
    "    else:\n",
    "        return 'Ortalama Müşteri'\n",
    " \n",
    "\n",
    "data_rfm['Segment'] = data_rfm.apply(segment_customer, axis=1)\n",
    " \n",
    "\n",
    "print(data_rfm[['Customer_ID', 'RFMI_Score', 'Segment']].head(20))\n",
    "data_rfm['Segment'].value_counts()"
   ]
