    "def age_state(age):\n",
    "    if age < 7:\n",
    "        return \"Baby\"\n",
    "    elif 7 <= age < 18: \n",
    "        return \"child\"\n",
    "    elif 18 <= age < 35: \n",
    "        return \"Young\"\n",
    "    elif 35 <= age < 50:\n",
    "        return \"Adult\"\n",
    "    else:\n",
    "        return \"Old\"\n",
    "\n",
    "data[\"Age_State\"] = data[\"Age\"].apply(age_state) \n",
    "\n",
    "data[\"Age_State\"].value_counts()\n",
    "print(\"*******************\")\n",
    "data[\"Age_State\"].value_counts(1)"
   ]
