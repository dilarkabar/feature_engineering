      "num_cols: 8 --> ['Customer_ID', 'Purchase_Date', 'Product_Price', 'Total_Purchase_Amount', 'Age', 'Revenue', 'Month', 'Hour']\n",
      "cat_but_car: 1 --> ['Customer_Name']\n",
      "num_but_cat: 4 --> ['Quantity', 'Returns', 'Churn', 'Year']\n"
     ]
    }
   ],
   "source": [
    "def Değişken_Türü(df, cat=10, car=10):\n",
    "    cat_col = [col for col in df.columns if df[col].dtypes == \"O\"]\n",
    "    num_but_cat = [col for col in df.columns if df[col].dtypes != \"O\" and df[col].nunique() < cat]\n",
    "    cat_but_car = [col for col in df.columns if df[col].dtypes == \"O\" and df[col].nunique() > car]\n",
    "    \n",
    "    cat_col = [col for col in cat_col if col not in num_but_cat] \n",
    "    num_col = [col for col in df.columns if df[col].dtypes != \"O\"]\n",
    "    num_col = [col for col in num_col if col not in num_but_cat]  \n",
    "    \n",
    "    \n",
    "    print(f\"Observations: {df.shape[0]}\")\n",
    "    print(f\"Variables: {df.shape[1]}\")\n",
    "    print(f'cat_cols: {len(cat_col)} --> {cat_col}')\n",
    "    print(f'num_cols: {len(num_col)} --> {num_col}')\n",
    "    print(f'cat_but_car: {len(cat_but_car)} --> {cat_but_car}')\n",
    "    print(f'num_but_cat: {len(num_but_cat)} --> {num_but_cat}')\n",
    "    \n",
    "    return cat_col, num_col, cat_but_car\n",
    "\n",
    "\n",
    "cat_col, num_col, cat_but_car = Değişken_Türü(data)"
   ]
  },
